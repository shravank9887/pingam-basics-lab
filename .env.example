# Copy to .env (or run `make secrets`, which generates random passwords + a shared DS deployment ID).
# .env is git-ignored. Every value here is read by docker-compose.yaml.

COMPOSE_PROJECT_NAME=pingam-basics

# ---- Product versions: must match the files in artifacts/
AM_VERSION=8.0.2
DS_VERSION=8.0.2

# ---- Hostnames / ports
# Add "127.0.0.1 am.example.com" to your hosts file so the browser and the
# containers use the same AM URL. Smoke tests use curl --resolve (no hosts entry needed).
AM_FQDN=am.example.com
AM_COOKIE_DOMAIN=example.com
AM_HTTP_PORT=8080

# Host-mapped LDAP ports (containers use 1389/1636/4444 internally)
DS_CONFIG_LDAP_PORT=1389
DS_CONFIG_LDAPS_PORT=1636
DS_CONFIG_ADMIN_PORT=4444
DS_IDENTITIES_LDAP_PORT=2389
DS_IDENTITIES_LDAPS_PORT=2636
DS_IDENTITIES_ADMIN_PORT=5444
DS_CTS_LDAP_PORT=3389
DS_CTS_LDAPS_PORT=3636
DS_CTS_ADMIN_PORT=6444

# ---- Secrets (make secrets fills empty *_PASSWORD and DS_DEPLOYMENT_ID)
AM_ADMIN_PASSWORD=
DS_ROOT_PASSWORD=
DS_MONITOR_PASSWORD=
DS_DEPLOYMENT_PASSWORD=
DS_DEPLOYMENT_ID=
AM_CONFIG_PASSWORD=
AM_IDENTITY_PASSWORD=
AM_CTS_PASSWORD=
TRUSTSTORE_PASSWORD=
